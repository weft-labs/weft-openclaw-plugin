FROM node:24.20.0-bookworm-slim

RUN npm install --global pnpm@10.33.4

WORKDIR /plugin

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
RUN pnpm install --frozen-lockfile

COPY README.md LICENSE SKILLS_REF openclaw.plugin.json tsconfig.json ./
COPY agent-plugin ./agent-plugin
COPY scripts/check-openclaw.mjs scripts/dogfood.mjs ./scripts/
COPY src ./src
RUN pnpm run build

ENV OPENCLAW_STATE_DIR=/tmp/openclaw-dogfood

USER node

CMD ["pnpm", "run", "dogfood"]
